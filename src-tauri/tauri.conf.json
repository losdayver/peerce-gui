{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peerce GUI",
  "version": "0.2.0-5",
  "identifier": "local.peerce-gui-tauri-nodejs",
  "build": {
    "beforeDevCommand": "npm run watch:dev",
    "beforeBuildCommand": "npm run compile && npm run prepare:bundle",
    "devUrl": "http://127.0.0.1:4310",
    "frontendDist": "../dist/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Peerce",
        "url": "static/index.html",
        "width": 1200,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:4310 ws://127.0.0.1:4310; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../dist/backend": "dist/backend",
      "../package.json": "package.json",
      "../dist/runtime/node-LICENSE": "node-LICENSE"
    }
  }
}
