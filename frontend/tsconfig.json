{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../dist/frontend",

    "target": "esnext",

    "lib": ["ES2024", "DOM"],
    "typeRoots": ["../node_modules/@types"],
    
    "module": "esnext",

    "moduleDetection": "force",

    "noEmit": true,
    
    "strictNullChecks": true,
    "noImplicitAny": false,

    "jsx": "react-jsx"
  },
  "include": ["src"]
}

