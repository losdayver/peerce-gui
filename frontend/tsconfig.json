{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../dist/frontend",

    "target": "esnext",

    "lib": ["ES2024", "DOM"],
    "typeRoots": ["../node_modules/@types", "../commonTypes"],

    "module": "esnext",

    "moduleDetection": "force",

    "noEmit": true,

    "strictNullChecks": true,
    "noImplicitAny": false,

    "jsx": "react-jsx",

    "paths": {
      "@commonTypes/*": ["../commonTypes/*"]
    }
  },
  "include": ["src"]
}
