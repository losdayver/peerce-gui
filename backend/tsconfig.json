{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../dist/backend",

    "target": "esnext",

    "module": "nodenext",
    "moduleResolution": "nodenext",

    "lib": ["esnext"],
    "types": ["node"],
    "typeRoots": ["../node_modules/@types", "../commonTypes"],

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strictNullChecks": true,
    "noImplicitAny": false,

    "noEmitOnError": true,

    "sourceMap": true,

    "paths": {
      "@commonTypes/*": ["../commonTypes/*"]
    }
  },
  "include": ["src"]
}
